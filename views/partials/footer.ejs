<!-- Footer -->
    <footer class="bg-emerald-950 text-emerald-100 pt-14 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b border-emerald-800/70">
            <div>
                <div class="flex items-center gap-3 mb-4">
                    <img 
                        src="/images/logo.png" 
                        alt="Logo <%= info.nama %>" 
                        class="w-12 h-12 object-contain rounded-xl bg-white p-1 shadow-sm"
                    />
                    <div>
                        <h3 class="text-white font-bold text-base sm:text-lg leading-tight"><%= info.nama %></h3>
                        <span class="text-xs text-amber-400 font-semibold"><%= info.cabang %></span>
                    </div>
                </div>
                <p class="text-sm text-emerald-200/80 leading-relaxed">
                    Lembaga keuangan mikro syariah yang berkomitmen mendorong pertumbuhan ekonomi umat dan pelaku UMKM secara adil tanpa riba.
                </p>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Tautan Cepat</h4>
                <ul class="space-y-2 text-sm text-emerald-200/80">
                    <li><a href="#tentang" class="hover:text-amber-400 transition">Profil & Legalitas</a></li>
                    <li><a href="#produk" class="hover:text-amber-400 transition">Simpanan Wadiah & Mudharabah</a></li>
                    <li><a href="#produk" class="hover:text-amber-400 transition">Pembiayaan Modal UMKM</a></li>
                    <li><a href="#simulasi" class="hover:text-amber-400 transition">Kalkulator Angsuran</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3"><%= info.cabang %></h4>
                <ul class="space-y-2.5 text-sm text-emerald-200/80">
                    <li class="flex items-start gap-2.5">
                        <i class="fa-solid fa-location-dot text-amber-400 mt-1"></i>
                        <span><%= info.alamat %></span>
                    </li>
                    <li class="flex items-center gap-2.5">
                        <i class="fa-solid fa-phone text-amber-400"></i>
                        <span><%= info.telepon %></span>
                    </li>
                    <li class="flex items-center gap-2.5">
                        <i class="fa-solid fa-clock text-amber-400"></i>
                        <span><%= info.jamOperasional %></span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 text-center text-xs text-emerald-300/70">
            &copy; <%= new Date().getFullYear() %> <%= info.nama %> — <%= info.cabang %>. Seluruh Hak Cipta Dilindungi.
        </div>
    </footer>

    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/<%= info.whatsapp %>?text=Assalamu'alaikum%20Admin%20KSPPS%20Tunas%20Artha%20Mandiri%20Syari'ah%20(KCP%20Kab.%20Cirebon),%20saya%20ingin%20bertanya%20tentang%20layanan%20koperasi."
       target="_blank"
       aria-label="Chat WhatsApp Admin"
       class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-3 rounded-full shadow-xl transition transform hover:scale-105">
        <i class="fa-brands fa-whatsapp text-2xl"></i>
        <span class="hidden sm:inline text-sm font-bold">Tanya Petugas</span>
    </a>

    <script src="/js/script.js"></script>
</body>
</html>